# Dependencies
node_modules/

# Build output
out/
dist/

# Bundled mpv (large binary, users download separately or we attach to release)
resources/mpv/
# NB: ignore directory *contents* (not the dir itself) so the !whitelists below
# can re-include specific files. `dir/` blocks all whitelisting under it.
build/mpv/portable_config/scripts/*
build/mpv/portable_config/fonts/*

# Keep config templates and our own scripts; downloaded modernz/font stays ignored
!build/mpv/portable_config/mpv.conf
!build/mpv/portable_config/input.conf
!build/mpv/portable_config/script-opts/modernz.conf
!build/mpv/portable_config/scripts/nocturne_select.lua
!build/mpv/portable_config/scripts/open-subtitles.lua

# Electron
.electron-vite/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Env
.env
.env.local

# Logs
*.log
npm-debug.log*

# Sharp build artifacts
.sharp/

# TypeScript
*.tsbuildinfo

# Dev-only AI session state
CLAUDE.md
.omc/

# Ad-hoc local verification scripts written during debug sessions.
# Canonical guards live under scripts/ and ARE committed — this only
# excludes one-off scratch files dropped at the repo root.
/verify-*.cjs
/verify-*.js
/verify-*.mjs

# Audit log + memory artifacts
/docs/AUDIT-*.md.bak
