<ui:FluentWindow x:Class="Nocturne.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Nocturne.App.ViewModels"
        xmlns:views="clr-namespace:Nocturne.App.Views"
        xmlns:controls="clr-namespace:Nocturne.App.Controls"
        Title="Nocturne" Height="900" Width="1400"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="{Binding BackdropType, Mode=OneWay}"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DetailViewModel}">
            <views:DetailPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
            <views:AnalyticsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OnboardingViewModel}">
            <views:OnboardingPage />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 Native Fluent TitleBar with Snap Layout Support -->
        <ui:TitleBar Grid.Row="0" Title="Nocturne">
            <ui:TitleBar.Header>
                <Grid Margin="12,0,0,0" Visibility="{Binding IsNavigationVisible, Converter={StaticResource BoolToVisibility}}">
                    <!-- Quick Search Box -->
                    <ui:TextBox Width="340" Height="32" VerticalAlignment="Center"
                                PlaceholderText="Search movies, shows, episodes..."
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Shell Navigation & Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView Grid.Column="0" x:Name="RootNav"
                               IsBackButtonVisible="Collapsed"
                               PaneDisplayMode="Left"
                               OpenPaneLength="220"
                               Visibility="{Binding IsNavigationVisible, Converter={StaticResource BoolToVisibility}}"
                               SelectionChanged="OnNavSelectionChanged">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Home" Tag="home" Click="OnNavItemClicked">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Libraries" Tag="library" Click="OnNavItemClicked">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Folder24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Analytics" Tag="analytics" Click="OnNavItemClicked">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DataTrending24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="Settings" Tag="settings" Click="OnNavItemClicked">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <!-- Main Content Area -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- In-Window Video Player Overlay (Full Shell Overlay, ZIndex=600) -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="600" Background="#000000"
              Visibility="{Binding IsPlayerActive, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Player Top Bar (Header row strictly above HWND - avoids Win32 airspace clipping) -->
            <Grid Grid.Row="0" Background="#141414">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Exit Button + Prev/Next Episode + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource AmberPrimaryButton}"
                            Padding="12,6"
                            Click="OnExitPlayerClick"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Exit (Esc)" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Previous Episode Button -->
                    <Button Style="{StaticResource AmberPrimaryButton}"
                            Padding="10,6"
                            Margin="0,0,8,0"
                            Visibility="{Binding CanGoPrevEpisode, Converter={StaticResource BoolToVisibility}}"
                            Click="OnPrevEpisodeClick"
                            ToolTip="Previous Episode (&lt;)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Previous24" FontSize="14" Margin="0,0,4,0" />
                            <TextBlock Text="Prev" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Next Episode Button -->
                    <Button Style="{StaticResource AmberPrimaryButton}"
                            Padding="10,6"
                            Margin="0,0,16,0"
                            Visibility="{Binding CanGoNextEpisode, Converter={StaticResource BoolToVisibility}}"
                            Click="OnNextEpisodeClick"
                            ToolTip="Next Episode (&gt;)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Next" FontSize="12" Margin="0,0,4,0" />
                            <ui:SymbolIcon Symbol="Next24" FontSize="14" />
                        </StackPanel>
                    </Button>

                    <!-- Title & Subtitle -->
                    <TextBlock Text="{Binding PlayerTitle}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="450" />
                    <TextBlock Text="{Binding PlayerSubtitle}" FontSize="13" Foreground="#999999"
                               Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                </StackPanel>

                <!-- Right: TheIntroDB Amber Skip Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource AmberPrimaryButton}"
                            Padding="16,8"
                            Content="{Binding SkipPromptText}"
                            Visibility="{Binding IsSkipPromptVisible, Converter={StaticResource BoolToVisibility}}"
                            Click="OnSkipPromptClick" />
                </StackPanel>
            </Grid>

            <!-- Pure Win32 HWND Host for MPV -->
            <controls:MpvHwndHost x:Name="PlayerHwndHost" Grid.Row="1" Focusable="True" />
        </Grid>

        <!-- Full-Window Splash Screen Overlay -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="999" Background="#0C0C0C"
              Visibility="{Binding IsSplashVisible, Converter={StaticResource BoolToVisibility}}">
            <!-- Ambient Nocturne Amber Radial Glow -->
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.45" RadiusX="0.6" RadiusY="0.5">
                        <GradientStop Color="#2EE5A00D" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Glowing Amber Logo -->
                <TextBlock Text="N O C T U R N E" FontSize="38" FontWeight="Light"
                           Foreground="{StaticResource NocturneAmberBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,28">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#E5A00D" BlurRadius="28" ShadowDepth="0" Opacity="0.55" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Loading Ring -->
                <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"
                                 Foreground="{StaticResource NocturneAmberBrush}"
                                 HorizontalAlignment="Center" Margin="0,0,0,18" />

                <!-- Status Text -->
                <TextBlock Text="{Binding SplashStatusText}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
