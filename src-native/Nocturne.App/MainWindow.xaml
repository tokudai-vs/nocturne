<ui:FluentWindow x:Class="Nocturne.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Nocturne.App.ViewModels"
        xmlns:views="clr-namespace:Nocturne.App.Views"
        xmlns:controls="clr-namespace:Nocturne.App.Controls"
        Title="Nocturne" Height="900" Width="1400"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="{Binding BackdropType, Mode=OneWay}"
        ExtendsContentIntoTitleBar="True"
        BorderThickness="0"
        BorderBrush="Transparent"
        Padding="0"
        Margin="0">

    <ui:FluentWindow.Resources>
        <!-- ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DetailViewModel}">
            <views:DetailPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
            <views:AnalyticsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OnboardingViewModel}">
            <views:OnboardingPage />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.Resources>
            <!-- Top Navigation Tab Button Style -->
            <Style x:Key="TopNavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 Fluent Header & Top Navigation Bar -->
        <Grid Grid.Row="0" Background="Transparent" MouseDown="OnTitleBarMouseDown">
            <!-- 3 Columns: Left Navigation & Brand | Center Search | Right User & Controls -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left Brand & Top Navigation Tabs -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <!-- Nocturne Logo & Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0" Cursor="Hand" MouseDown="OnLogoMouseDown">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource NocturneAmberBrush}" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="16" Foreground="#111111" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="NOCTURNE" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Navigation Tabs (Home & Libraries) -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsNavigationVisible, Converter={StaticResource BoolToVisibility}}">
                    <!-- Home Button -->
                    <Button Click="OnHomeTabClick" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="{StaticResource NocturneAmberBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,8,0"
                                           Foreground="{Binding IsHomeActive, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="Home" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Libraries Button -->
                    <Button Click="OnLibraryTabClick" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibraryActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="{StaticResource NocturneAmberBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="16" Margin="0,0,8,0"
                                           Foreground="{Binding IsLibraryActive, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="Libraries" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Column 1: Centered Search Bar -->
            <Grid Grid.Column="1" HorizontalAlignment="Center" Width="440"
                  Visibility="{Binding IsNavigationVisible, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBox x:Name="SearchBox" Height="36" VerticalAlignment="Center"
                            PlaceholderText="Search movies, shows, episodes... (Ctrl+K)"
                            Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=250}">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ui:TextBox.Icon>
                </ui:TextBox>
            </Grid>

            <!-- Column 2: User Profile Dropdown + Windows 11 TitleBar Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                <!-- User Profile Avatar Button -->
                <Button x:Name="UserProfileButton" Click="OnUserProfileClick"
                        Width="36" Height="36" Margin="0,0,12,0" Padding="0" Cursor="Hand"
                        Visibility="{Binding IsNavigationVisible, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Profile &amp; Settings">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="18" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUserInitial}" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource NocturneAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource NocturneAmberBrush}" />
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                    <!-- Context Menu with Settings, Analytics, Switch Server, Logout -->
                    <Button.ContextMenu>
                        <ContextMenu x:Name="UserProfileContextMenu" Placement="Bottom"
                                     Background="{DynamicResource ApplicationBackgroundBrush}"
                                     BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <MenuItem Header="{Binding CurrentUserName}" FontWeight="Bold" IsEnabled="False" />
                            <MenuItem Header="{Binding CurrentServerName}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsEnabled="False" />
                            <Separator />
                            <MenuItem Header="Analytics" Click="OnAnalyticsMenuClick">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="DataTrending24" FontSize="16" Foreground="{StaticResource NocturneAmberBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Settings" Click="OnSettingsMenuClick">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{StaticResource NocturneAmberBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Switch Server" Click="OnSwitchServerMenuClick">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Sign Out" Click="OnLogoutMenuClick">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="SignOut24" FontSize="16" Foreground="#FF5555" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Windows 11 Native Fluent TitleBar with Snap Layout Support -->
                <ui:TitleBar x:Name="AppTitleBar" Title=""
                             ShowMaximize="True" ShowMinimize="True" ShowClose="True"
                             VerticalAlignment="Center" Height="52" Width="138" />
            </StackPanel>
        </Grid>

        <!-- Pure Edge-to-Edge Content Area -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />

        <!-- In-Window Video Player Overlay (Full Shell Overlay, ZIndex=600) -->
        <Grid x:Name="PlayerOverlayGrid" Grid.RowSpan="2" Panel.ZIndex="600" Background="#000000"
              Visibility="{Binding IsPlayerActive, Converter={StaticResource BoolToVisibility}}">
            <!-- Pure Win32 HWND Host for MPV (Full Window Video Display) -->
            <controls:MpvHwndHost x:Name="PlayerHwndHost" Focusable="True" />
        </Grid>

        <!-- Full-Window Splash Screen Overlay (Theme Adaptive) -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="999" Background="{DynamicResource ApplicationBackgroundBrush}"
              Visibility="{Binding IsSplashVisible, Converter={StaticResource BoolToVisibility}}">
            <!-- Ambient Nocturne Amber Radial Glow -->
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.45" RadiusX="0.6" RadiusY="0.5">
                        <GradientStop Color="#2EE5A00D" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Glowing Amber Logo -->
                <TextBlock Text="N O C T U R N E" FontSize="38" FontWeight="Light"
                           Foreground="{StaticResource NocturneAmberBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,28">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#E5A00D" BlurRadius="28" ShadowDepth="0" Opacity="0.55" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Loading Ring -->
                <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"
                                 Foreground="{StaticResource NocturneAmberBrush}"
                                 HorizontalAlignment="Center" Margin="0,0,0,18" />

                <!-- Status Text -->
                <TextBlock Text="{Binding SplashStatusText}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
