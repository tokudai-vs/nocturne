<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nocturne Amber Identity Brushes -->
    <Color x:Key="NocturneAmberColor">#E5A00D</Color>
    <Color x:Key="NocturneAmberHoverColor">#F0B429</Color>
    <Color x:Key="NocturneAmberMutedColor">#B37D0A</Color>

    <SolidColorBrush x:Key="NocturneAmberBrush" Color="{StaticResource NocturneAmberColor}" />
    <SolidColorBrush x:Key="NocturneAmberHoverBrush" Color="{StaticResource NocturneAmberHoverColor}" />
    <SolidColorBrush x:Key="NocturneAmberMutedBrush" Color="{StaticResource NocturneAmberMutedColor}" />
    <SolidColorBrush x:Key="NocturneAmberTintBrush" Color="#33E5A00D" />
    <Color x:Key="NocturneSplashGlowColor">#2EE5A00D</Color>
    <RadialGradientBrush x:Key="SplashRadialGlowBrush" Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.6" RadiusY="0.5">
        <GradientStop Color="{StaticResource NocturneSplashGlowColor}" Offset="0.0" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </RadialGradientBrush>

    <!-- Glass & Border Brushes -->
    <SolidColorBrush x:Key="GlassBorderDarkBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="GlassBorderLightBrush" Color="#14000000" />
    <SolidColorBrush x:Key="CardBackdropDarkBrush" Color="#B31A1A1A" />
    <SolidColorBrush x:Key="CardBackdropLightBrush" Color="#CCFFFFFF" />

    <!-- Theme-Adaptive Horizontal Scroll Edge Gradients (Default Dark, Dynamically Swapped) -->
    <LinearGradientBrush x:Key="ScrollEdgeLeftBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#C0000000" Offset="0.0" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollEdgeRightBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#00000000" Offset="0.0" />
        <GradientStop Color="#C0000000" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Amber Accent Primary Button Style -->
    <Style x:Key="AmberPrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource NocturneAmberBrush}" />
        <Setter Property="Foreground" Value="#111111" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource NocturneAmberHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
