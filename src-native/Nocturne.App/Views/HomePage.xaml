<UserControl x:Class="Nocturne.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Nocturne.App.Controls">

    <Grid>
        <!-- Top Loading Indicator -->
        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" Panel.ZIndex="10"
                     Foreground="{DynamicResource NocturneAmberBrush}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,40">

                <!-- Hero Section (Backdrop bleeds into top navigation bar with smooth bottom dissolve) -->
                <Grid Height="500" Visibility="{Binding HeroItem, Converter={StaticResource NullToVisibility}}" ClipToBounds="True">
                    <!-- Background Backdrop Container with OpacityMask (Text & Watch Now button are unmasked overlays) -->
                    <Grid>
                        <Grid.OpacityMask>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.75" />
                                <GradientStop Color="#CCFFFFFF" Offset="0.88" />
                                <GradientStop Color="#40FFFFFF" Offset="0.96" />
                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Grid.OpacityMask>

                        <!-- Backdrop Image -->
                        <Image Source="{Binding HeroBackdropUrl}" Stretch="UniformToFill" />

                        <!-- Background Trailer Player (Without sound, looping, fallback to image if failed) -->
                        <MediaElement x:Name="HeroTrailerPlayer"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      IsMuted="True"
                                      Volume="0"
                                      Stretch="UniformToFill"
                                      Visibility="Collapsed"
                                      MediaOpened="OnTrailerMediaOpened"
                                      MediaEnded="OnTrailerMediaEnded"
                                      MediaFailed="OnTrailerMediaFailed" />

                        <!-- Left Reading Scrim for Text Contrast -->
                        <Border HorizontalAlignment="Left" Width="680">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#E0000000" Offset="0.0" />
                                    <GradientStop Color="#A0000000" Offset="0.45" />
                                    <GradientStop Color="#40000000" Offset="0.75" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Bottom Soft Diffusion Scrim -->
                        <Border VerticalAlignment="Bottom" Height="140">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0.0" />
                                    <GradientStop Color="#25000000" Offset="0.4" />
                                    <GradientStop Color="#60000000" Offset="0.7" />
                                    <GradientStop Color="#B0000000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Hero Info (Placed outside the OpacityMask so text and Watch Now button are 100% crisp, vibrant and never masked) -->
                    <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,36" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding HeroItem.Name}" FontSize="36" FontWeight="Bold"
                                   Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.75" />
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Meta Badges -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                    Visibility="{Binding HeroItem.ProductionYear, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding HeroItem.ProductionYear}" FontSize="12" Foreground="White" />
                            </Border>
                            <Border Background="{DynamicResource NocturneAmberTintBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                    Visibility="{Binding HeroItem.CommunityRating, Converter={StaticResource NullToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Star16" FontSize="12" Foreground="{DynamicResource NocturneAmberBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding HeroItem.CommunityRating, Converter={StaticResource RatingFormatter}}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NocturneAmberBrush}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding HeroItem.OfficialRating}" FontSize="12" Foreground="#B0B0B0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Overview -->
                        <TextBlock Text="{Binding HeroItem.Overview}" FontSize="13" Foreground="#E0E0E0"
                                   TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,0,0,20">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.6" />
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Play Hero Button -->
                        <Button Style="{StaticResource AmberPrimaryButton}" Click="OnPlayHeroClick" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="Watch Now" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Continue Watching Row (Horizontal Landscape Cards like official Emby app) -->
                <controls:MediaRow Title="Continue Watching"
                                   IsHorizontal="True"
                                   ItemsSource="{Binding ContinueWatching}"
                                   PlayClick="OnContinueWatchingPlayClick"
                                   ShowClick="OnContinueWatchingShowClick"
                                   EpisodeClick="OnContinueWatchingEpisodeClick"
                                   ItemClick="OnRowItemClick" />

                <!-- Next Up Episodes Row -->
                <controls:MediaRow Title="Next Up"
                                   ItemsSource="{Binding NextUp}"
                                   ItemClick="OnRowItemClick" />

                <!-- Latest Movies Row -->
                <controls:MediaRow Title="Latest Movies"
                                   ItemsSource="{Binding LatestMovies}"
                                   ItemClick="OnRowItemClick" />

                <!-- Latest Episodes Row -->
                <controls:MediaRow Title="Latest TV Episodes"
                                   ItemsSource="{Binding LatestEpisodes}"
                                   ItemClick="OnRowItemClick" />

                <!-- Empty State Message when no rows exist and not loading -->
                <Border Margin="40,80" Padding="36" CornerRadius="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" MaxWidth="520"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="46"
                                       Foreground="{DynamicResource NocturneAmberBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <TextBlock Text="Your media library is empty or syncing" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="If you just connected your server, background synchronization is indexing your media collections. You can also click Refresh below."
                                   FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />
                        <Button Style="{StaticResource AmberPrimaryButton}" HorizontalAlignment="Center" Click="OnRefreshClick">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="Refresh Home" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

