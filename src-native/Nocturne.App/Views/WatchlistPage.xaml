<UserControl x:Class="Nocturne.App.Views.WatchlistPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="32,60,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header, Filter & Sort Controls -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <!-- Left: Page Title & Filter -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Watchlist" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,24,0" />

                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Filter, Mode=TwoWay}" MinWidth="130" VerticalAlignment="Center">
                    <ComboBoxItem Content="All Items" Tag="All" />
                    <ComboBoxItem Content="Movies" Tag="Movies" />
                    <ComboBoxItem Content="TV Shows" Tag="Shows" />
                </ComboBox>
            </StackPanel>

            <!-- Right: Sort controls & Loading indicator -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Sort by:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SortBy, Mode=TwoWay}" MinWidth="130" Margin="0,0,8,0">
                    <ComboBoxItem Content="Date Added" Tag="DateAdded" />
                    <ComboBoxItem Content="Title" Tag="Title" />
                    <ComboBoxItem Content="Release Year" Tag="Year" />
                </ComboBox>

                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SortOrder, Mode=TwoWay}" MinWidth="110" Margin="0,0,16,0">
                    <ComboBoxItem Content="Descending" Tag="Descending" />
                    <ComboBoxItem Content="Ascending" Tag="Ascending" />
                </ComboBox>

                <ProgressBar IsIndeterminate="True" Width="80" Height="4"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DockPanel>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Empty State (§12.4) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon Symbol="Bookmark24" FontSize="56"
                               Foreground="{DynamicResource NocturneAmberBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock Text="Nothing here yet" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="Add titles from any poster, or connect Trakt to bring yours across."
                           FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" />
            </StackPanel>

            <!-- Grid of Watchlist Cards -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="160" Margin="6,8" Cursor="Hand" MouseLeftButtonUp="OnCardClick">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Poster Box -->
                                <Border Grid.Row="0" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <!-- Text Tile for unowned items / fallback without poster -->
                                        <Grid Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                                <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="36"
                                                               Foreground="{DynamicResource NocturneAmberBrush}"
                                                               HorizontalAlignment="Center" Margin="0,0,0,10" />
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           TextAlignment="Center" TextWrapping="Wrap"
                                                           MaxHeight="70" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding YearText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextAlignment="Center" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           TextAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Poster Image if available -->
                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />

                                        <!-- Remove from Watchlist button (Top Right) -->
                                        <Button Width="26" Height="26" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="6"
                                                Background="#D9141414" BorderThickness="1"
                                                BorderBrush="{DynamicResource NocturneAmberBrush}"
                                                Click="OnRemoveClick" ToolTip="Remove from Watchlist">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="13" />
                                                </Style>
                                            </Button.Resources>
                                            <ui:SymbolIcon Symbol="Bookmark24" FontSize="13"
                                                           Foreground="{DynamicResource NocturneAmberBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>

                                    </Grid>
                                </Border>

                                <!-- Title & Subtitle -->
                                <StackPanel Grid.Row="1" Margin="2,6,2,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding YearText}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
