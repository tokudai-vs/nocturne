<Window x:Class="Nocturne.App.Views.PlayerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        Focusable="True">

    <Grid x:Name="OverlayRootGrid" Background="#01000000"
          MouseMove="OnOverlayMouseMove"
          MouseDown="OnOverlayMouseDown">

        <!-- Top Floating Controls Bar -->
        <Border x:Name="TopControlsBar" VerticalAlignment="Top" Height="80">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#E6000000" Offset="0.0" />
                    <GradientStop Color="#80000000" Offset="0.6" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="24,14,24,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Circular Back Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OnExitClick" Width="42" Height="42" Margin="0,0,16,0" Cursor="Hand" ToolTip="Exit Playback (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="21" Background="#60000000" BorderBrush="#35FFFFFF" BorderThickness="1">
                                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource NocturneAmberBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Title & Subtitle -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlayerTitle}" FontSize="18" FontWeight="Bold"
                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                        <TextBlock Text="{Binding PlayerSubtitle}" FontSize="13" Foreground="#B0B0B0"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="450" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Prev / Next Episode Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Prev Episode -->
                    <Button Click="OnPrevEpisodeClick" Margin="0,0,10,0" Padding="12,7" Cursor="Hand"
                            Background="#50000000" BorderBrush="#30FFFFFF" BorderThickness="1"
                            Visibility="{Binding CanGoPrevEpisode, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Previous Episode (&lt;)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Previous24" FontSize="15" Foreground="#FFFFFF" Margin="0,0,5,0" />
                            <TextBlock Text="Prev" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Button>

                    <!-- Next Episode -->
                    <Button Click="OnNextEpisodeClick" Padding="12,7" Cursor="Hand"
                            Style="{StaticResource AmberPrimaryButton}"
                            Visibility="{Binding CanGoNextEpisode, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Next Episode (&gt;)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Next" FontSize="12" FontWeight="Bold" Margin="0,0,5,0" />
                            <ui:SymbolIcon Symbol="Next24" FontSize="15" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center Skip Button (TheIntroDB Segment Skip) -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,36,130"
                    Visibility="{Binding IsSkipPromptVisible, Converter={StaticResource BoolToVisibility}}">
            <Button Click="OnSkipPromptClick" Style="{StaticResource AmberPrimaryButton}"
                    Padding="22,12" Cursor="Hand" ToolTip="Skip Segment (Enter)">
                <Button.Effect>
                    <DropShadowEffect Color="{DynamicResource NocturneAmberColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.6" />
                </Button.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="FastForward24" FontSize="18" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding SkipPromptText}" FontSize="15" FontWeight="Bold" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Bottom Floating Controls Bar -->
        <Border x:Name="BottomControlsBar" VerticalAlignment="Bottom" Height="110">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#00000000" Offset="0.0" />
                    <GradientStop Color="#80000000" Offset="0.3" />
                    <GradientStop Color="#E6000000" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="24,0,24,14" VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Timeline Scrubber & Time Display -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Slider x:Name="TimelineSlider" Grid.Column="0"
                            Minimum="0"
                            Maximum="{Binding TotalDurationSeconds}"
                            Value="{Binding CurrentPlaybackSeconds, Mode=OneWay}"
                            PreviewMouseDown="OnSliderMouseDown"
                            PreviewMouseUp="OnSliderMouseUp"
                            VerticalAlignment="Center"
                            Cursor="Hand" />

                    <TextBlock Grid.Column="1" Text="{Binding TimeString}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#FFFFFF" Margin="16,0,4,0" VerticalAlignment="Center" />
                </Grid>

                <!-- Row 1: Player Control Buttons -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Play/Pause, -10s, +10s, Prev, Next -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Play / Pause Button -->
                        <Button Click="OnPlayPauseClick" Width="44" Height="44" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="22" Background="{DynamicResource NocturneAmberBrush}">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Pause24" FontSize="20" Foreground="#111111"
                                                           Visibility="{Binding IsPaused, Converter={StaticResource InvertBoolToVisibility}}" />
                                            <ui:SymbolIcon Symbol="Play24" FontSize="20" Foreground="#111111" Margin="2,0,0,0"
                                                           Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource NocturneAmberHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Seek -10s -->
                        <Button Click="OnSeekBackClick" Width="36" Height="36" Margin="0,0,6,0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" ToolTip="Rewind 10s (Left Arrow)">
                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="18" Foreground="#FFFFFF" />
                        </Button>

                        <!-- Seek +10s -->
                        <Button Click="OnSeekForwardClick" Width="36" Height="36" Margin="0,0,14,0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" ToolTip="Fast Forward 10s (Right Arrow)">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18" Foreground="#FFFFFF" />
                        </Button>

                        <!-- Volume Icon + Slider -->
                        <ui:SymbolIcon Symbol="Speaker224" FontSize="18" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Slider Width="90" Minimum="0" Maximum="100"
                                Value="{Binding Volume, Mode=TwoWay}"
                                VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand" />
                    </StackPanel>

                    <!-- Right: Fullscreen Toggle -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="OnFullscreenToggleClick" Width="36" Height="36" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" ToolTip="Toggle Fullscreen (F)">
                            <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="18" Foreground="#FFFFFF" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
