<UserControl x:Class="Nocturne.App.Views.DetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Nocturne.App.Controls">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Backdrop Image with Gradient Vignette -->
                <Grid Height="480" VerticalAlignment="Top">
                    <Image Source="{Binding BackdropUrl}" Stretch="UniformToFill" />
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#40000000" Offset="0.0" />
                                <GradientStop Color="#A00C0C0C" Offset="0.6" />
                                <GradientStop Color="#FF0C0C0C" Offset="1.0" />
                            </LinearGradientBrush>
                        </Grid.Background>
                    </Grid>
                </Grid>

                <!-- Main Content Container -->
                <StackPanel Margin="36,24,36,48">
                    <!-- Back Button -->
                    <ui:Button Click="OnBackClick" Width="38" Height="38" Margin="0,0,0,16"
                               HorizontalAlignment="Left" CornerRadius="19"
                               Background="#80000000" Foreground="White" BorderThickness="0">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" />
                    </ui:Button>

                    <!-- Hero Info Block -->
                    <Grid Margin="0,20,0,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Poster -->
                        <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True" Height="330"
                                BorderBrush="{StaticResource GlassBorderDarkBrush}" BorderThickness="1">
                            <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                        </Border>

                        <!-- Details Column -->
                        <StackPanel Grid.Column="1" Margin="32,10,0,0">
                            <TextBlock Text="{Binding Item.Name}" FontSize="34" FontWeight="Bold"
                                       Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <!-- Meta Badges Row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Item.ProductionYear}" FontSize="13" Foreground="#C0C0C0" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Item.RunTimeTicks, Converter={StaticResource TicksToDuration}}"
                                           FontSize="13" Foreground="#C0C0C0" Margin="0,0,12,0" VerticalAlignment="Center" />

                                <!-- Resolution Badge (4K / 1080p) -->
                                <Border Background="#25FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                        Visibility="{Binding Item.ResolutionBadge, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="{Binding Item.ResolutionBadge}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>

                                <!-- Codec Badge (HEVC / H264) -->
                                <Border Background="#25FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,12,0"
                                        Visibility="{Binding Item.CodecBadge, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="{Binding Item.CodecBadge}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>

                                <!-- Community Rating Badge -->
                                <Border Background="#33E5A00D" CornerRadius="4" Padding="8,2" Margin="0,0,8,0"
                                        Visibility="{Binding Item.CommunityRating, Converter={StaticResource NullToVisibility}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Star16" FontSize="12" Foreground="{StaticResource NocturneAmberBrush}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Item.CommunityRating, Converter={StaticResource RatingFormatter}}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource NocturneAmberBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Version Picker (Multi-Server Dedup) -->
                            <StackPanel Margin="0,0,0,18" Visibility="{Binding HasMultipleVersions, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Available Versions" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                                <ComboBox HorizontalAlignment="Left" MinWidth="260"
                                          ItemsSource="{Binding GroupVersions}"
                                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ResolutionBadge}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding CodecBadge}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="•" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding ServerName}" Foreground="{StaticResource NocturneAmberBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Action Buttons Row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <!-- Play Button -->
                                <Button Style="{StaticResource AmberPrimaryButton}" Click="OnPlayClick" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Play24" FontSize="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Play" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <!-- Watch Trailer Button -->
                                <Button Click="OnWatchTrailerClick" Margin="0,0,12,0" Padding="14,8"
                                        Visibility="{Binding HasTrailer, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Video24" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Watch Trailer" />
                                    </StackPanel>
                                </Button>

                                <!-- Watched Toggle Button -->
                                <Button Click="OnPlayedToggleClick" Margin="0,0,8,0" Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Played" />
                                    </StackPanel>
                                </Button>

                                <!-- Favorite Toggle Button -->
                                <Button Click="OnFavoriteToggleClick" Margin="0,0,8,0" Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Heart24" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Favorite" />
                                    </StackPanel>
                                </Button>

                                <!-- Trakt Watchlist Bookmark Toggle -->
                                <Button Click="OnWatchlistToggleClick" Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Bookmark24" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Watchlist" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Overview Text -->
                            <TextBlock Text="Overview" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Item.Overview}" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>
                    </Grid>

                    <!-- Cast & Crew Row -->
                    <StackPanel Visibility="{Binding People, Converter={StaticResource NullToVisibility}}" Margin="0,8,0,32">
                        <TextBlock Text="Cast &amp; Crew" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14" />
                        <ItemsControl ItemsSource="{Binding People}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,12,8" Padding="12,8" CornerRadius="8"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Width="120">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Role}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- TV Series Episodes Section -->
                    <StackPanel Visibility="{Binding Seasons, Converter={StaticResource NullToVisibility}}" Margin="0,8,0,32">
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="Episodes" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <ComboBox HorizontalAlignment="Right" MinWidth="160"
                                      ItemsSource="{Binding Seasons}"
                                      SelectedItem="{Binding SelectedSeason}"
                                      DisplayMemberPath="Name" />
                        </DockPanel>

                        <!-- Episodes List -->
                        <ItemsControl ItemsSource="{Binding Episodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" Padding="16,12" CornerRadius="8"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Padding="12,6" Style="{StaticResource AmberPrimaryButton}"
                                                    Click="OnPlayEpisodeClick" Margin="12,0,0,0">
                                                <ui:SymbolIcon Symbol="Play16" FontSize="14" />
                                            </Button>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Overview}" FontSize="12" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           MaxHeight="36" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Similar Items Row -->
                    <controls:MediaRow Title="More Like This"
                                       ItemsSource="{Binding SimilarItems}"
                                       Visibility="{Binding SimilarItems, Converter={StaticResource NullToVisibility}}" />

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Floating TheIntroDB Amber Skip Button Overlay -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,40"
                Visibility="{Binding ActiveSkipPrompt, Converter={StaticResource NullToVisibility}}">
            <Button Style="{StaticResource AmberPrimaryButton}" Padding="20,12"
                    Click="OnExecuteSkipClick">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="FastForward24" FontSize="18" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ActiveSkipPrompt.ActionLabel}" FontSize="15" FontWeight="Bold" />
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</UserControl>
