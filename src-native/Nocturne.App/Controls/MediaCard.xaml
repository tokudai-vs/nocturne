<UserControl x:Class="Nocturne.App.Controls.MediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Cursor="Hand"
             MouseLeftButtonUp="OnCardClick">

    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource NocturneAmberBrush}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.05" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.05" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.0" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.0" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Right-Click Context Menu -->
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Play" Click="OnContextMenuPlayClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Play16" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Toggle Played" Click="OnContextMenuTogglePlayedClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Checkmark16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Toggle Favorite" Click="OnContextMenuToggleFavoriteClick">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Heart16" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Grid Width="160" Margin="6,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Poster Box -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" ClipToBounds="True">
            <Grid>
                <!-- Fallback Icon -->
                <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="36"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Poster Image -->
                <Image x:Name="PosterImage" Stretch="UniformToFill" />

                <!-- Version Count Badge (for deduplicated items) -->
                <Border x:Name="VersionBadge" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="6" Padding="6,2" CornerRadius="4" Background="#D9141414"
                        BorderBrush="{DynamicResource NocturneAmberBrush}" BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock x:Name="VersionBadgeText" Text="2 copies" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource NocturneAmberBrush}" />
                </Border>

                <!-- Played Badge -->
                <Border x:Name="PlayedBadge" Width="22" Height="22" CornerRadius="11"
                        Background="#2EA043" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="6" Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="Checkmark16" FontSize="12" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Progress Bar -->
                <ProgressBar x:Name="ProgressBar" Height="4" VerticalAlignment="Bottom"
                             Foreground="{DynamicResource NocturneAmberBrush}"
                             Background="#40000000" BorderThickness="0"
                             Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Title & Info -->
        <StackPanel Grid.Row="1" Margin="2,6,2,0">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="SubtitleText" FontSize="11" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
