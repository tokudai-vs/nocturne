<UserControl x:Class="Nocturne.App.Controls.MediaRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Nocturne.App.Controls"
             Margin="0,12,0,24">

    <UserControl.Resources>
        <!-- Standard Vertical Poster Card (Movies, TV Shows, Collections) -->
        <DataTemplate x:Key="VerticalCardTemplate">
            <controls:MediaCard CardClick="OnMediaCardClick" />
        </DataTemplate>

        <!-- Official Emby Style Horizontal Card (Continue Watching, 16:9 Artwork, All 3 Elements Clickable) -->
        <DataTemplate x:Key="HorizontalCardTemplate">
            <controls:ContinueWatchingCard PlayClick="OnContinueWatchingPlayClick"
                                           ShowClick="OnContinueWatchingShowClick"
                                           EpisodeClick="OnContinueWatchingEpisodeClick" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Title -->
        <TextBlock x:Name="HeaderTitle" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="20,0,20,10" />

        <!-- Horizontal Scroller Container with Floating Scroll Buttons and Hidden Scrollbar -->
        <Grid Grid.Row="1" MouseEnter="OnRowMouseEnter" MouseLeave="OnRowMouseLeave">
            <ScrollViewer x:Name="RowScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnPreviewMouseWheel">
                <ItemsControl x:Name="ItemsHost" Margin="14,0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ItemTemplate="{StaticResource VerticalCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Gradient Scrim under Left Button (Theme adaptive fade, only visible on hover) -->
            <Border x:Name="LeftScrim" HorizontalAlignment="Left" Width="80"
                    Background="{DynamicResource ScrollEdgeLeftBrush}" IsHitTestVisible="False" Panel.ZIndex="5" Opacity="0" />

            <!-- Floating Circular Left Scroll Button -->
            <Button x:Name="LeftScrollButton" Click="OnScrollLeftClick"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Width="42" Height="42" Margin="10,0,0,0"
                    Opacity="0" Cursor="Hand" Panel.ZIndex="10" ToolTip="Scroll Left">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="21" Background="#E0141416" BorderBrush="#55FFFFFF" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.8" />
                            </Border.Effect>
                            <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource NocturneAmberBrush}" />
                                <Setter TargetName="b" Property="Background" Value="#F51E1E22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Gradient Scrim under Right Button (Theme adaptive fade, only visible on hover) -->
            <Border x:Name="RightScrim" HorizontalAlignment="Right" Width="80"
                    Background="{DynamicResource ScrollEdgeRightBrush}" IsHitTestVisible="False" Panel.ZIndex="5" Opacity="0" />

            <!-- Floating Circular Right Scroll Button -->
            <Button x:Name="RightScrollButton" Click="OnScrollRightClick"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="42" Height="42" Margin="0,0,10,0"
                    Opacity="0" Cursor="Hand" Panel.ZIndex="10" ToolTip="Scroll Right">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="21" Background="#E0141416" BorderBrush="#55FFFFFF" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.8" />
                            </Border.Effect>
                            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource NocturneAmberBrush}" />
                                <Setter TargetName="b" Property="Background" Value="#F51E1E22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>
